+                if (!segment.reference.isNullOrBlank()) {
+                    Text(segment.reference, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                }
+            }
+        }
+    }
+}
